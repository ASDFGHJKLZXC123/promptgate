{
	"name": "@promptgate/shared",
	"version": "1.0.0",
	"type": "module",
	"files": [
		"dist"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"development": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./eval": {
			"types": "./dist/eval.d.ts",
			"development": "./src/eval.ts",
			"default": "./dist/eval.js"
		}
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.json --outDir dist --rootDir src && find dist -type f -name '*.test.js' -delete && find dist -type f -name '*.test.d.ts' -delete"
	},
	"dependencies": {
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/node": "^22.20.1",
		"vitest": "^4.1.10"
	}
}
